{
  "name": "paladin-text",
  "version": "0.1.0",
  "private": true,
  "description": "仙劍奇俠傳（終端文字版）— 以升級練武與劇情為核心的純文字 RPG",
  "main": "dist/index.js",
  "bin": {
    "paladin": "dist/index.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "build:web": "tsx scripts/build-web.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
